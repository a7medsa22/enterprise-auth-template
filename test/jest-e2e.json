{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleDirectories": [
    "node_modules",
    "<rootDir>/../../apps/demo/node_modules"
  ],
  "transform": {
    "^.+\\.ts$": ["ts-jest", {
      "tsconfig": "<rootDir>/tsconfig.e2e.json"
    }]
  }
}
