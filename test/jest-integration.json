{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "moduleDirectories": ["node_modules", "<rootDir>/../apps/demo/node_modules"],
  "moduleNameMapper": {
    "^@auth-template/nestjs-adapter$": "<rootDir>/../packages/nestjs-adapter/src/index",
    "^@auth-template/nestjs-adapter/(.*)$": "<rootDir>/../packages/nestjs-adapter/src/$1",
    "^@auth-template/core$": "<rootDir>/../packages/core/src/index",
    "^@auth-template/core/(.*)$": "<rootDir>/../packages/core/src/$1"
  },
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.e2e.json"
      }
    ]
  }
}
