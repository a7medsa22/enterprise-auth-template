# .env.example

# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL / Neon)
# keep Neon credentials secure: do not expose them to client-side code
# DATABASE_URL='postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require'
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# Redis / Upstash Redis (if using Redis storage)
# CACHE_PROVIDER=redis
# REDIS_URL='rediss://default:your-upstash-password@your-endpoint.upstash.com:6379'
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-change-me-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Password Hashing
BCRYPT_ROUNDS=10

# Rate Limiting (optional - for future implementation)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=10

# OAuth Configuration
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/oauth/facebook/callback

# Apple OAuth
APPLE_CLIENT_ID=com.yourapp.service
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_LOCATION=./certs/AuthKey_XXXXXXXXXX.p8
APPLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/apple/callback

# SMTP Mail Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Auth Template <noreply@example.com>"