{
  "name": "auth-template",
  "version": "1.0.0",
  "description": "Enterprise-grade authentication template with Clean Architecture",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter \"@auth-template/core\" run build",
    "build:nestjs": "pnpm --filter \"@auth-template/nestjs-adapter\" run build",
    "build:demo": "pnpm --filter \"demo-api\" run build",
    "dev": "pnpm --filter \"demo-api\" run start:dev",
    "start": "pnpm --filter \"demo-api\" run start",
    "start:prod": "pnpm --filter \"demo-api\" run start:prod",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "test:cov": "pnpm -r run test:cov",
    "test:integration:up": "docker-compose -f docker/testing/docker-compose.test.yml up -d",
    "test:integration:down": "docker-compose -f docker/testing/docker-compose.test.yml down",
    "test:integration": "pnpm --filter \"demo-api\" run test:integration",
    "test:e2e": "pnpm --filter \"demo-api\" run test:e2e",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "docker:dev": "docker-compose -f docker/development/docker-compose.yml up",
    "docker:prod": "docker-compose -f docker/production/docker-compose.prod.yml up -d",
    "migration:generate": "cd apps/demo-api && typeorm migration:generate",
    "migration:run": "cd apps/demo-api && typeorm migration:run",
    "migration:revert": "cd apps/demo-api && typeorm migration:revert"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.0.0",
    "prettier": "^3.2.4",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
