{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./dist",
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@auth-template/core": ["../core/dist/index"],
      "@auth-template/core/*": ["../core/dist/*"],
      "@auth-template/typeorm": ["../typeorm/dist/index"],
      "@auth-template/typeorm/*": ["../typeorm/dist/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../core" },
    { "path": "../typeorm" }
  ]
}
