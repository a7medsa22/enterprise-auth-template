{
  "name": "@auth-template/nestjs-adapter",
  "version": "1.0.0",
  "description": "NestJS adapter for auth-template core",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "pnpm exec jest --passWithNoTests",
    "test:watch": "pnpm exec jest --watch",
    "test:cov": "pnpm exec jest --coverage",
    "lint": "pnpm exec eslint src/**/*.ts",
    "lint:fix": "pnpm exec eslint src/**/*.ts --fix"
  },
  "keywords": [
    "nestjs",
    "authentication",
    "jwt",
    "passport"
  ],
  "author": "Ahmed Salah",
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "typeorm": "^0.3.0"
  },
  "dependencies": {
    "@auth-template/core": "workspace:*",
    "@nestjs/bull": "^10.2.3",
    "argon2": "^0.31.2",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "ioredis": "^5.3.2",
    "nodemailer": "^9.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
